<!DOCTYPE html>
<html lang="es-MX">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#202a3a" />
    <title>@ViewData["Title"] · CivicFix</title>
    <link rel="icon" type="image/png" href="~/images/civicfix-mark.png" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar">
            <a class="brand" asp-controller="Reports" asp-action="Create" aria-label="CivicFix, inicio">
                <span class="brand-mark">
                    <img src="~/images/civicfix-mark.png" asp-append-version="true" alt="" />
                </span>
                <span class="brand-copy"><strong>CivicFix</strong><small>@(User.IsInRole(CivicFixRoles.Admin) ? "ADMIN PANEL" : "PORTAL CIUDADANO")</small></span>
            </a>

            <div class="nav-caption">Principal</div>
            <nav class="side-nav" aria-label="Navegación principal">
                @if (User.IsInRole(CivicFixRoles.Admin))
                {
                    <a class="side-link" asp-controller="Home" asp-action="Index">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
                        <span>Dashboard</span>
                    </a>
                    <a class="@(Context.Request.RouteValues["controller"]?.ToString() == "AdminUsers" ? "side-link is-active" : "side-link")" asp-controller="AdminUsers" asp-action="Index">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3"/><path d="M3 20v-2a6 6 0 0 1 12 0v2M17 8h4M19 6v4"/></svg>
                        <span>Administradores</span>
                    </a>
                    <a class="side-link is-active" asp-controller="Home" asp-action="Index" aria-current="page">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="3" width="12" height="18" rx="2"/><path d="M9 7h6M9 11h6M9 15h4"/></svg>
                        <span>Reportes</span><span class="nav-count">@((ViewData["ReportCount"] as int?) ?? 12)</span>
                    </a>
                    <span class="side-link side-link--muted" aria-disabled="true">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3"/><path d="M3 20v-2a6 6 0 0 1 12 0v2M16 5.5a3 3 0 0 1 0 5.8M18 14a5 5 0 0 1 3 4.6V20"/></svg>
                        <span>Cuadrillas</span><span class="nav-count nav-count--green">6</span>
                    </span>
                    <span class="side-link side-link--muted" aria-disabled="true">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20v-6M10 20V8M16 20V4M22 20v-9"/></svg>
                        <span>Estadísticas</span>
                    </span>
                    <span class="side-link side-link--muted" aria-disabled="true">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="m19.4 15 .1.1 1.4 1.1-1.4 2.4-1.7-.7a8 8 0 0 1-1.5.9l-.3 1.8h-2.8l-.3-1.8a8 8 0 0 1-1.5-.9l-1.7.7-1.4-2.4 1.4-1.1a8 8 0 0 1 0-1.8l-1.4-1.1 1.4-2.4 1.7.7a8 8 0 0 1 1.5-.9l.3-1.8h2.8l.3 1.8a8 8 0 0 1 1.5.9l1.7-.7 1.4 2.4-1.4 1.1a8 8 0 0 1 0 1.7Z" transform="translate(-1 -1) scale(1.08)"/></svg>
                        <span>Configuración</span>
                    </span>
                }
                else
                {
                    <a class="side-link is-active" asp-controller="Reports" asp-action="Create">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="3" width="12" height="18" rx="2"/><path d="M9 7h6M9 11h6M9 15h4"/></svg>
                        <span>Nuevo reporte</span>
                    </a>
                }
            </nav>

            @if (User.IsInRole(CivicFixRoles.Admin))
            {
                <div class="nav-caption nav-caption--system">Sistema</div>
                <nav class="side-nav side-nav--secondary" aria-label="Ayuda">
                    <span class="side-link side-link--muted">Soporte</span>
                    <span class="side-link side-link--muted">Documentación</span>
                </nav>
            }

            <div class="sidebar-user">
                <span class="avatar">@(User.Identity?.Name?.Substring(0, 1).ToUpperInvariant() ?? "U")</span>
                <span class="user-copy"><strong>@(User.Identity?.Name ?? "Usuario")</strong><small>@(User.IsInRole(CivicFixRoles.Admin) ? "Administrador" : "Ciudadano")</small></span>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button class="logout-button" type="submit" title="Cerrar sesión" aria-label="Cerrar sesión">↪</button>
                </form>
            </div>
        </aside>

        <div class="workspace">
            <header class="topbar">
                <div class="topbar-title">
                    <span class="topbar-kicker">Zona Metropolitana</span>
                    <strong>@(User.IsInRole(CivicFixRoles.Admin) ? "Centro de operaciones" : "Atención ciudadana")</strong>
                </div>
                <div class="topbar-actions">
                    @if (User.IsInRole(CivicFixRoles.Admin))
                    {
                        <form class="top-search" asp-controller="Home" asp-action="Index" method="get">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.5"/><path d="m16 16 4.5 4.5"/></svg>
                            <input type="search" name="busqueda" value="@Context.Request.Query["busqueda"]" placeholder="Buscar folio, ubicación..." aria-label="Buscar reportes" />
                        </form>
                    }
                    <a class="button button--primary top-create" asp-controller="Reports" asp-action="Create">
                        <span aria-hidden="true">+</span><span>@(User.IsInRole(CivicFixRoles.Admin) ? "Nuevo reporte" : "Reportar problema")</span>
                    </a>
                </div>
            </header>

            <main class="main-content" role="main">
            @RenderBody()
            </main>

            <footer class="app-footer">
                <span>CivicFix · Gestión de servicios urbanos</span>
                <span>Zona Metropolitana</span>
            </footer>
        </div>
    </div>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
